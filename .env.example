# Isi nilai asli di file .env (bukan di sini), lalu JANGAN commit .env.
# .env sudah di-gitignore; file .env.example ini HANYA template placeholder.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Path lokal ke file key service account GEE, ATAU isi JSON mentahnya
# (dipakai seperti itu di GitHub Secrets - lihat radensa/ee_client.py).
EE_SERVICE_ACCOUNT_JSON=
